# Adres strony (do linków w sitemap, Open Graph). Bez ukośnika na końcu.
NEXT_PUBLIC_SITE_URL=https://goatreps.com

# Adres CDN z folderem cdn/ wgranym na S3 (i/, t/, q/, p/, c/, a/, b/). Bez ukośnika na końcu.
# Pusty = zdjęcia podawane przez samą stronę z folderu ../cdn (albo CDN_DIR) pod /cdn/...
# Uwaga: zmienne NEXT_PUBLIC_* są wkompilowane przy "npm run build" – po zmianie przebuduj stronę.
NEXT_PUBLIC_CDN_URL=https://cdn.goatreps.com

# Tylko gdy NEXT_PUBLIC_CDN_URL jest pusty: gdzie leży folder cdn/ (domyślnie ../cdn obok folderu strony).
# CDN_DIR=/home/container/cdn

# Nagłówek z prawdziwym adresem odwiedzającego. Za Cloudflare: cf-connecting-ip.
# Bez tego limity zapytań liczą się wspólnie dla wszystkich. Port serwera wystaw tylko dla Cloudflare.
# Za Cloudflare: cf-connecting-ip. Na Vercelu: x-real-ip.
TRUST_PROXY=cf-connecting-ip

# Panel admina (/admin): hasło (min. 8 znaków) i osobny klucz do podpisywania sesji (min. 12 znaków, inny niż hasło).
# Puste = panel wyłączony. Klucz wygenerujesz np.: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Zmiana ADMIN_SECRET wylogowuje wszystkich.
ADMIN_PASSWORD=
ADMIN_SECRET=

# Opcjonalnie logowanie dwuetapowe (kod z aplikacji). Klucz generuje: node ../narzedzia/admin-2fa.mjs
# Nieprawidłowy klucz blokuje logowanie (2FA nie wyłącza się po cichu).
ADMIN_TOTP_SECRET=

# Wyszukiwanie po zdjęciu (/photo-search) – wystarczy jeden dostawca; kolejność prób: OpenAI → Gemini → Claude.
# Klucze zostają na serwerze, nigdy nie trafiają do przeglądarki.
OPENAI_API_KEY=
OPENAI_BASE_URL=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# limity (domyślnie 20 na adres IP na godzinę, 500 na dobę dla całej strony)
IMAGE_SEARCH_HOURLY_LIMIT=
IMAGE_SEARCH_DAILY_LIMIT=
