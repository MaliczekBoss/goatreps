  "formula": [
    "plnPerUsd = (rates.USD > 0 && rates.PLN > 0) ? rates.PLN / rates.USD : 4",
    "r = parseFloat(option.originalPrice) * plnPerUsd",
    "base = (isNaN(r) || r === 0) ? option.price : r",
    "shown = voucherOn ? Math.max(0, base - 55).toFixed(2) : base.toFixed(2)   // + \" zł\"",
    "voucherOn => dodatkowo \"bez kuponu: {base.toFixed(2)} zł\""
  ],
